
# ==================================================
# TRI-NAYANTRA — MAIN BACKEND ENVIRONMENT
# ==================================================

# --- LLM ---
# Leave both providers empty to use the rule-based fallback.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5

OLLAMA_URL=
OLLAMA_MODEL=llama3.2


# --- REMOTE YOLO / PPE DETECTION SERVICE ---
# URL of the separately deployed detection microservice.
# Example: https://tri-nayantra-detection.onrender.com
DETECTION_SERVICE_URL=

# Must match the token configured in the detection service.
# Generate a long random secret. Never expose it in frontend code.
DETECTION_SERVICE_TOKEN=

# Detection service request timeouts (seconds).
DETECTION_CONNECT_TIMEOUT=3
DETECTION_READ_TIMEOUT=20


# --- MODEL REFERENCES ---
# YOLO/PPE models are loaded ONLY by the detection microservice.
YOLO_MODEL=yolov8n.pt
PPE_MODEL=models/ppe_best.pt

# Speech and MRI remain configured separately.
WHISPER_MODEL=small
MRI_MODEL=models/mri_classifier.pt


# --- ALERTS ---
# Optional webhook for HELP, fall and PPE violation events.
ALERT_WEBHOOK_URL=


# --- CORS ---
# Comma-separated frontend origins.
# Add your Vercel frontend URL when deploying.
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500


# --- PROCESSING LIMITS ---
MAX_IMAGE_UPLOAD_MB=12
MAX_IMAGE_PIXELS=16000000


# --- APPLICATION ---
DEBUG=false
