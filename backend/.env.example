# --- LLM (pick one; with none set, a rule-based fallback is used) ---
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5
OLLAMA_URL=
OLLAMA_MODEL=llama3.2
# --- Models ---
YOLO_MODEL=yolov8n.pt
PPE_MODEL=models/ppe_best.pt
WHISPER_MODEL=small
MRI_MODEL=models/mri_classifier.pt
# --- Alerts: POST JSON here when HELP / fall / PPE violation is raised ---
ALERT_WEBHOOK_URL=
# --- CORS: frontend origin(s), comma separated ---
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
